# TruthShield AI Environment Variables Configuration
# Local-First Digital Content Protection Platform

APP_NAME="TruthShield AI"
ENV=development
DEBUG=false

# Direct-access mode: set REQUIRE_AUTH=false to disable login/signup requirements
REQUIRE_AUTH=false

# Security (Generate a strong random 32+ character key in production)
SECRET_KEY="truthshield-replace-with-strong-random-secret-key"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
RATE_LIMIT_RPM=180

# Database Configuration
DATABASE_URL="sqlite:///./truthshield.db"
# Production PostgreSQL (Docker):
# DATABASE_URL="postgresql+psycopg://truthshield_user:strong_password@localhost:5432/truthshield_db"

# Background Queue
REDIS_URL="redis://localhost:6379/0"

# Local AI (Ollama & Whisper)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
OLLAMA_VISION_MODEL="llava"
WHISPER_MODEL_SIZE="tiny"

# Frontend API URL
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
